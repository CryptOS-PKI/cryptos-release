# Deny everything by default, then re-allow only chart sources that need
# headers. Scoping the allow-list to charts/ (rather than *.yaml everywhere)
# keeps the shared .github governance files — which carry their own comment
# headers, not golic license blocks — out of the check.
*

# Allow directory traversal so the globs below can match.
!*/

# Chart YAML + Helm template sources.
!charts/**/*.yaml
!charts/**/*.yml
!charts/**/*.tpl

# Never generated or vendored sub-charts.
charts/*/charts/
